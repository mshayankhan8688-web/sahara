PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/heartspace
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Native Gemini image model (Nano Banana / Flash Image). Needs image quota on the same API key.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_PLACES_API_KEY=
# Optional. Without these, local development shows the reset code on screen (NODE_ENV=development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Private key for reading feedback. At least 16 characters. Leave blank until you set one.
FEEDBACK_REVIEW_SECRET=
# Daily AI usage limits (UTC day). Tune these to control Gemini spend.
FREE_CHAT_DAILY=40
FREE_STUDIO_DAILY=8
FREE_IMAGE_DAILY=2
FREE_DIAGRAM_DAILY=12
PREMIUM_CHAT_DAILY=400
PREMIUM_STUDIO_DAILY=80
PREMIUM_IMAGE_DAILY=40
PREMIUM_DIAGRAM_DAILY=80
# Display prices (PKR). Checkout stays off until PAYMENTS_ENABLED=true and a real gateway is wired.
PREMIUM_MONTHLY_PKR=500
PREMIUM_ANNUAL_PKR=4800
PAYMENTS_ENABLED=false
